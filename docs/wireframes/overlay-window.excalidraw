  },
  {
   "id": "v1-text-300",
   "type": "text",
   "x": 1340,
   "y": 1950,
   "width": 677.6,
   "height": 120.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "v1-group-299"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 683180148,
   "version": 1,
   "versionNonce": 15420946,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1761231600000,
   "link": null,
   "locked": false,
   "text": "C · no second window: Ctrl+D brings the main window of Exile Market\nover the game, where the player put it and at its size, then sends it\nback behind the game when it closes.\n+ nothing new to learn or to design; the player chooses the place once.\n+ a player with two screens keeps it on the other one: nothing over the game.\n− the same place for every item, maybe over what the player looks at.",
   "originalText": "C · no second window: Ctrl+D brings the main window of Exile Market\nover the game, where the player put it and at its size, then sends it\nback behind the game when it closes.\n+ nothing new to learn or to design; the player chooses the place once.\n+ a player with two screens keeps it on the other one: nothing over the game.\n− the same place for every item, maybe over what the player looks at.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "v1-text-302",
   "type": "text",
   "x": 0,
   "y": 2570,
   "width": 471.90000000000003,
   "height": 27.5,
   "angle": 0,
