   "boundElements": null,
   "updated": 1761231600000,
   "link": null,
   "locked": false,
   "text": "B · the whole narrow window (420 px wide, the full height of the game),\nnext to the inventory when the item is on the right half of the screen,\nnext to the stash when it is on the left half: never over the panel\nthe item is in. The content is the frame \"Narrow · main\" of\nwindow-layouts.excalidraw, without a new design.\n+ everything at once: stats, filters, offers, as in the main window.\n+ what Exiled Exchange 2 players know.\n− hides a third of the game; far from the cursor.",
   "originalText": "B · the whole narrow window (420 px wide, the full height of the game),\nnext to the inventory when the item is on the right half of the screen,\nnext to the stash when it is on the left half: never over the panel\nthe item is in. The content is the frame \"Narrow · main\" of\nwindow-layouts.excalidraw, without a new design.\n+ everything at once: stats, filters, offers, as in the main window.\n+ what Exiled Exchange 2 players know.\n− hides a third of the game; far from the cursor.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
